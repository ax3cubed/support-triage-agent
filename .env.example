# Model provider key. Any provider langchain's init_chat_model supports works; Anthropic is installed by default.
ANTHROPIC_API_KEY=

# LangSmith: traces and evaluation experiments.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=support-triage-agent

# Optional overrides.
# TRIAGE_MODEL=anthropic:claude-sonnet-5-5
# TRIAGE_JUDGE_MODEL=anthropic:claude-opus-5-5
